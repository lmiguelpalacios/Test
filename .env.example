# Optional Supabase / Preview mode. If either value is missing/invalid, the app
# stays in local demo mode (Workspace v4 localStorage) — no hybrid writes.
#
# Never put service_role keys here. Frontend uses the anon (publishable) key only.
#
# Preview/Test (Cloudflare Pages): point at nordlicht-security-review only —
# never claim Production / handels until migrations + explicit freigabe.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional override. Default: "supabase" when URL+anon are set, else "local".
# VITE_DATA_BACKEND=local
# VITE_DATA_BACKEND=supabase
